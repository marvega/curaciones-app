PORT=3001
BACKEND_URL=http://localhost:3000
# This server's own public origin — the RFC 9728 resource identifier MCP
# clients use to discover the Authorization Server. Origin only: no path,
# no query, no fragment. In prod this is the Cloud Run URL of this service.
MCP_RESOURCE_URL=http://localhost:3001
OAUTH_ISSUER=http://localhost:3000
OAUTH_JWKS_URL=http://localhost:3000/jwks.json
OAUTH_AUDIENCE=http://localhost:3000
LOG_LEVEL=debug
NODE_ENV=development
