# PostgreSQL - para desarrollo local
# Crear una BD en Render o local con Docker
DATABASE_URL=postgresql://user:password@localhost:5432/curaciones

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Puerto (opcional, default 3000)
PORT=3000

# Saltos de reverse-proxy confiables delante de este proceso. NO usar `true`:
# eso hace que req.ip sea el elemento más a la izquierda de X-Forwarded-For,
# es decir un valor que el cliente controla, y el rate limit se evade rotando
# la cabecera. Default 1 = confiar sólo en el peer TCP (la infra de Google).
# Medir antes de subirlo: GET /api/health/proxy con x-health-token.
TRUST_PROXY_HOPS=1

# Token para los endpoints de diagnóstico /api/health/memory y
# /api/health/proxy. Sin él ambos devuelven 404. Variable de entorno normal,
# no un secreto de Secret Manager.
# HEALTH_TOKEN=

# ── OAuth 2.0 / OIDC Authorization Server ─────────────────────────────────────
# Issuer URL — debe coincidir con el origin público en prod (ej:
# https://curaciones.web.app). Tokens emitidos llevan este valor en `iss`.
# OBLIGATORIA con NODE_ENV=production: el arranque falla si falta.
OAUTH_ISSUER=http://localhost:3000

# Cookie secret usado por oidc-provider para firmar cookies de interaction.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# OBLIGATORIA con NODE_ENV=production, y el valor de abajo está rechazado
# explícitamente: es público, cualquiera podría firmar cookies con él.
OAUTH_COOKIE_SECRET=change-in-production

# ── KMS (encripta signing keys OAuth + columnas con datos sensibles) ──────────
# Backends disponibles:
#   memory  → en-memoria con HKDF, sólo para dev/test
#   aws     → AWS KMS, requiere KMS_CMK_ARN + AWS_REGION (default si no se setea)
KMS_BACKEND=memory

# Master key para KMS_BACKEND=memory (32 bytes hex = 64 chars).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KMS_LOCAL_MASTER_KEY=

# Para KMS_BACKEND=aws:
# KMS_CMK_ARN=arn:aws:kms:us-east-1:000000000000:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AWS_REGION=us-east-1

# ── Email ─────────────────────────────────────────────────────────────────────
# Backends: noop (descarta), resend (requiere RESEND_API_KEY)
EMAIL_BACKEND=noop
# RESEND_API_KEY=re_xxxxxxxxxxxx
