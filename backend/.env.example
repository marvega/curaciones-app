# PostgreSQL - para desarrollo local
# Crear una BD en Render, Railway, o local con Docker
DATABASE_URL=postgresql://user:password@localhost:5432/curaciones

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Puerto (opcional, default 3000)
PORT=3000

# ── OAuth 2.0 / OIDC Authorization Server ─────────────────────────────────────
# Issuer URL — debe coincidir con el origin público en prod (ej:
# https://api.curaciones.cl). Tokens emitidos llevan este valor en `iss`.
OAUTH_ISSUER=http://localhost:3000

# Cookie secret usado por oidc-provider para firmar cookies de interaction.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OAUTH_COOKIE_SECRET=change-in-production

# ── KMS (encripta signing keys OAuth + columnas con datos sensibles) ──────────
# Backends disponibles:
#   memory  → en-memoria con HKDF, sólo para dev/test
#   aws     → AWS KMS, requiere KMS_CMK_ARN + AWS_REGION (default si no se setea)
KMS_BACKEND=memory

# Master key para KMS_BACKEND=memory (32 bytes hex = 64 chars).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KMS_LOCAL_MASTER_KEY=

# Para KMS_BACKEND=aws:
# KMS_CMK_ARN=arn:aws:kms:us-east-1:000000000000:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AWS_REGION=us-east-1

# ── Email ─────────────────────────────────────────────────────────────────────
# Backends: noop (descarta), resend (requiere RESEND_API_KEY)
EMAIL_BACKEND=noop
# RESEND_API_KEY=re_xxxxxxxxxxxx
